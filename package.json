{
 "name": "@signozhq/icons",
 "author": "SigNoz",
 "version": "0.1.0",
 "description": "SVG-based React icon components",
 "keywords": [
  "React",
  "SVG",
  "Icons"
 ],
 "module": "dist/index.esm.js",
 "types": "dist/types/index.d.ts",
 "files": [
  "dist"
 ],
 "scripts": {
  "prebuild": "pnpm run precheck",
  "precheck": "pnpm run clean && pnpm run lint",
  "clean": "rimraf src && rimraf dist",
  "build": "pnpm run svgr && rollup -c",
  "svgr": "rimraf src && svgr --typescript  --replace-attr-values '#1D1D1D=currentColor' --template ./svgr-template.js --index-template ./index-template.cjs -d src -- assets",
  "lint": "biome check .",
  "lint:fix": "biome check --write .",
  "type-check": "tsc --noEmit",
  "commitlint": "commitlint --edit",
  "format": "biome format --write .",
  "format:check": "biome format .",
  "changeset": "changeset",
  "version": "changeset version",
  "release": "pnpm run build && changeset publish",
  "storybook": "pnpm run svgr && storybook dev -p 6006",
  "build-storybook": "pnpm run svgr && storybook build",
  "update:browserslist": "pnpm dlx update-browserslist-db@latest"
 },
 "license": "MIT",
 "devDependencies": {
  "@babel/plugin-transform-runtime": "^7.22.5",
  "@babel/preset-env": "^7.16.4",
  "@babel/preset-react": "^7.16.0",
  "@babel/traverse": "^7.25.6",
  "@biomejs/biome": "^2.4.3",
  "@changesets/cli": "^2.27.8",
  "@rollup/plugin-babel": "^5.3.0",
  "@rollup/plugin-typescript": "^12.1.2",
  "@storybook/addon-a11y": "^10.2.10",
  "@storybook/addon-docs": "^10.2.10",
  "@storybook/react": "^10.2.10",
  "@storybook/react-vite": "^10.2.10",
  "@svgr/cli": "^6.1.2",
  "@types/react": "^18.2.0",
  "chromatic": "^15.1.1",
  "husky": "^8.0.3",
  "lint-staged": "^15.5.1",
  "react": "^18.2.0",
  "react-dom": "^18.2.0",
  "rimraf": "^3.0.2",
  "rollup": "^2.61.1",
  "rollup-plugin-filesize": "^10.0.0",
  "rollup-plugin-svgo": "^2.0.0",
  "rollup-plugin-terser": "^7.0.2",
  "storybook": "^10.2.10",
  "tslib": "^2.6.2",
  "typescript": "^5.1.3"
 },
 "dependencies": {
  "@babel/runtime": "^7.22.5",
  "@commitlint/cli": "^17.6.7",
  "@commitlint/config-conventional": "^17.6.7"
 },
 "lint-staged": {
  "*.{js,jsx,ts,tsx,json,jsonc}": [
   "biome check --write"
  ]
 },
 "resolutions": {
  "brace-expansion": "^2.0.2",
  "tmp": "0.2.4"
 },
 "pnpm": {
  "overrides": {
   "react": "^18.2.0",
   "react-dom": "^18.2.0"
  }
 }
}
