{
  "name": "@signozhq/icons",
  "author": "SigNoz",
  "version": "0.0.0",
  "description": "SVG-based React icon components",
  "keywords": [
    "React",
    "SVG",
    "Icons"
  ],
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm run precheck",
    "precheck": "pnpm run clean && pnpm run lint ",
    "clean": "rimraf src && rimraf dist",
    "build": "pnpm run svgr && rollup -c",
    "svgr": "svgr --typescript  --replace-attr-values '#1D1D1D=currentColor' --template ./svgr-template.js -d src -- assets",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@babel/plugin-transform-runtime": "^7.22.5",
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-react": "^7.16.0",
    "@babel/traverse": "^7.25.6",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@svgr/cli": "^6.1.2",
    "@types/react": "^19.0.10",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.4",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.1",
    "prettier": "^2.8.8",
    "react": "^19.0.0",
    "rimraf": "^3.0.2",
    "rollup": "^2.61.1",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-svgo": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "typescript": "^5.1.3",
    "tslib": "^2.6.2"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.5",
    "@commitlint/cli": "^17.6.7",
    "@commitlint/config-conventional": "^17.6.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "eslintIgnore": [
    "dist/**",
    "src/**",
    "assets/**",
    "*.svg"
  ]
}
