{
 "$schema": "https://biomejs.dev/schemas/2.4.3/schema.json",
 "vcs": {
  "enabled": true,
  "clientKind": "git",
  "useIgnoreFile": true
 },
 "files": {
  "includes": ["**", "!dist", "!assets", "!**/*.svg"]
 },
 "formatter": {
  "enabled": true,
  "indentStyle": "space",
  "indentWidth": 1,
  "lineWidth": 100
 },
 "javascript": {
  "formatter": {
   "quoteStyle": "single",
   "trailingCommas": "all",
   "semicolons": "always"
  }
 },
 "linter": {
  "enabled": true,
  "domains": {
   "project": "recommended",
   "react": "recommended",
   "types": "recommended"
  },
  "rules": {
   "recommended": true,
   "correctness": {
    "noUnusedImports": "error",
    "noUnusedVariables": "error",
    "useExhaustiveDependencies": "warn",
    "useHookAtTopLevel": "error",
    "useImportExtensions": {
     "options": {
      "extensionMappings": {
       "ts": "js",
       "tsx": "js"
      }
     }
    }
   },
   "style": {
    "noDefaultExport": "off",
    "useImportType": "error",
    "noNonNullAssertion": "warn"
   },
   "suspicious": {
    "noExplicitAny": "off",
    "noShadowRestrictedNames": "off",
    "noArrayIndexKey": "warn"
   },
   "a11y": {
    "useButtonType": "warn",
    "noSvgWithoutTitle": "off",
    "useKeyWithClickEvents": "warn",
    "noStaticElementInteractions": "warn",
    "useValidAnchor": "warn",
    "noLabelWithoutControl": "off",
    "useAriaPropsSupportedByRole": "warn"
   },
   "complexity": {
    "noImportantStyles": "off"
   }
  }
 },
 "css": {
  "formatter": {
   "enabled": false
  },
  "linter": {
   "enabled": false
  }
 },
 "overrides": [
  {
   "includes": ["*.config.js", "*.config.cjs", "*.config.mjs"],
   "linter": {
    "rules": {
     "suspicious": {
      "noExplicitAny": "off"
     }
    }
   }
  }
 ]
}
